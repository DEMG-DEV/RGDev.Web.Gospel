---
// Hero Section Component
---

<section id="inicio" class="relative overflow-hidden bg-gospel-navy-950 text-white pt-12 pb-24 lg:pt-20 lg:pb-32 border-b border-gospel-gold-500/20">
  <!-- Decorative Glow and Ambient Background -->
  <div class="absolute inset-0 opacity-20 pointer-events-none">
    <div class="absolute -top-40 -left-40 w-96 h-96 bg-gospel-gold-500 rounded-full blur-[128px]"></div>
    <div class="absolute top-1/2 -right-40 w-96 h-96 bg-blue-600 rounded-full blur-[128px]"></div>
    <div class="absolute bottom-0 left-1/3 w-80 h-80 bg-amber-400 rounded-full blur-[140px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-8 items-center">
      
      <!-- Left Content Column -->
      <div class="lg:col-span-7 text-center lg:text-left space-y-6">
        
        <!-- Category Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-1.5 rounded-full bg-gospel-navy-800/90 border border-gospel-gold-400/40 text-gospel-gold-300 text-xs sm:text-sm font-semibold tracking-wider uppercase shadow-inner">
          <span class="w-2 h-2 rounded-full bg-gospel-gold-400 animate-pulse"></span>
          <span>Un lugar para crecer en Dios</span>
        </div>

        <!-- Main Title -->
        <h1 class="text-4xl sm:text-6xl lg:text-7xl font-extrabold tracking-tight leading-tight">
          <span class="block text-white">¡JESÚS</span>
          <span class="gold-gradient-text block drop-shadow-sm">TRANSFORMA VIDAS!</span>
        </h1>

        <!-- Subtitle & Invitation -->
        <p class="text-xl sm:text-2xl text-amber-100/90 font-medium max-w-2xl mx-auto lg:mx-0">
          Ven, escucha y recibe el mensaje de esperanza.
        </p>

        <p class="text-base sm:text-lg text-slate-300 max-w-2xl mx-auto lg:mx-0 leading-relaxed">
          Ven con tu familia y amigos, Dios tiene un propósito para tu vida. Te invitamos a ser parte de una comunidad que camina en amor, fe y adoración.
        </p>

        <!-- Call to Action Buttons -->
        <div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-4 pt-4">
          <a 
            href="#horarios" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gold-gradient text-gospel-navy-950 font-bold px-8 py-4 rounded-xl text-base hover:brightness-110 shadow-xl shadow-gospel-gold-500/20 active:scale-95 transition-all"
          >
            <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
              <path fill-rule="evenodd" d="M6 2a1 1 0 00-1 1v1H4a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V6a2 2 0 00-2-2h-1V3a1 1 0 10-2 0v1H7V3a1 1 0 00-1-1zm0 5a1 1 0 000 2h8a1 1 0 100-2H6z" clip-rule="evenodd"/>
            </svg>
            <span>Ver Horarios de Servicios</span>
          </a>

          <a 
            href="#ubicacion" 
            class="w-full sm:w-auto inline-flex items-center justify-center gap-2 bg-gospel-navy-800/80 hover:bg-gospel-navy-700 text-white font-semibold px-8 py-4 rounded-xl border border-slate-700 hover:border-gospel-gold-400/50 transition-all text-base"
          >
            <svg class="w-5 h-5 text-gospel-gold-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>Cómo Llegar (La Noria)</span>
          </a>
        </div>

        <!-- Quick Info Strip -->
        <div class="pt-6 border-t border-slate-800/80 grid grid-cols-2 sm:grid-cols-3 gap-4 text-left">
          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-gospel-gold-500/10 border border-gospel-gold-500/30 flex items-center justify-center text-gospel-gold-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <p class="text-xs text-slate-400">Domingo</p>
              <p class="text-sm font-bold text-white">10:30 AM</p>
            </div>
          </div>

          <div class="flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-gospel-gold-500/10 border border-gospel-gold-500/30 flex items-center justify-center text-gospel-gold-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
            </div>
            <div>
              <p class="text-xs text-slate-400">Miércoles</p>
              <p class="text-sm font-bold text-white">7:00 PM</p>
            </div>
          </div>

          <div class="col-span-2 sm:col-span-1 flex items-center gap-3">
            <div class="w-9 h-9 rounded-lg bg-gospel-gold-500/10 border border-gospel-gold-500/30 flex items-center justify-center text-gospel-gold-400 shrink-0">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/></svg>
            </div>
            <div>
              <p class="text-xs text-slate-400">Ubicación</p>
              <p class="text-sm font-bold text-white">Col. La Noria</p>
            </div>
          </div>
        </div>

      </div>

      <!-- Right Visual Feature Column -->
      <div class="lg:col-span-5 flex justify-center">
        <div class="relative w-full max-w-md">
          <!-- Ambient Card Background -->
          <div class="absolute -inset-1.5 bg-gold-gradient rounded-3xl blur opacity-30 group-hover:opacity-100 transition duration-1000"></div>
          
          <div class="relative bg-gospel-navy-900 border border-gospel-gold-400/30 rounded-3xl p-6 shadow-2xl space-y-6">
            
            <!-- Graphic Header / Logo Display -->
            <div class="bg-white rounded-2xl p-6 flex flex-col items-center justify-center shadow-inner">
              <img 
                src="/assets/logo.jpg" 
                alt="Logotipo oficial de Gospel - Iglesia con Propósito" 
                width="400"
                height="400"
                fetchpriority="high"
                class="max-h-52 w-auto object-contain drop-shadow-sm" 
              />
            </div>

            <!-- Card Highlights -->
            <div class="space-y-3">
              <div class="flex items-center justify-between p-3 rounded-xl bg-gospel-navy-800/90 border border-slate-700/60">
                <span class="text-sm text-slate-300">Pastor Principal:</span>
                <span class="text-sm font-bold text-gospel-gold-300">Jesús Hernández</span>
              </div>
              <div class="p-3 rounded-xl bg-gospel-gold-500/10 border border-gospel-gold-500/30 text-center">
                <p class="text-xs font-semibold text-gospel-gold-300 tracking-wide uppercase">
                  Servir con amor y pasión a Dios, la iglesia y el mundo
                </p>
              </div>
            </div>

          </div>
        </div>
      </div>

    </div>
  </div>
</section>
