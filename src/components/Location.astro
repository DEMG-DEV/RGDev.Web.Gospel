---
// Location and Directions Component
const address = "Cto. Hacienda del Real 1716, Colonia La Noria";
const encodedAddress = encodeURIComponent(address);
const googleMapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodedAddress}`;
---

<section id="ubicacion" class="py-20 lg:py-28 bg-slate-50 relative border-t border-slate-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-3.5 py-1 rounded-full bg-gospel-gold-100 text-gospel-gold-700 text-xs sm:text-sm font-bold uppercase tracking-widest">
        ¿Cómo Llegar?
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gospel-navy-950 tracking-tight">
        Nuestra Ubicación
      </h2>
      <p class="text-slate-600 text-lg sm:text-xl">
        Estamos convenientemente ubicados en Colonia La Noria. Ven y acompáñanos.
      </p>
    </div>

    <!-- Main Location Card -->
    <div class="mt-16 max-w-4xl mx-auto bg-white rounded-3xl p-8 sm:p-12 border border-slate-200 shadow-xl grid grid-cols-1 md:grid-cols-12 gap-8 items-center">
      
      <!-- Pin & Address Detail -->
      <div class="md:col-span-7 space-y-6">
        <div class="flex items-start gap-4">
          <div class="w-14 h-14 rounded-2xl bg-gospel-navy-950 text-gospel-gold-400 flex items-center justify-center shrink-0 shadow-lg">
            <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
          </div>
          <div>
            <span class="text-xs uppercase tracking-wider font-bold text-slate-400">Dirección Oficial</span>
            <h3 class="text-2xl sm:text-3xl font-black text-gospel-navy-950 mt-1">
              Colonia La Noria
            </h3>
            <p class="text-slate-700 font-semibold text-base sm:text-lg mt-1">
              {address}
            </p>
          </div>
        </div>

        <!-- Features list -->
        <div class="space-y-2.5 pt-2 border-t border-slate-100 text-sm text-slate-600">
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Ambiente familiar y seguro</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Fácil acceso y estacionamiento en el área</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-4 h-4 text-emerald-500 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/></svg>
            <span>Equipo de bienvenida listo para recibirte</span>
          </div>
        </div>

        <!-- Action Buttons -->
        <div class="flex flex-wrap items-center gap-3 pt-4">
          <a 
            href={googleMapsUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 bg-gospel-navy-950 hover:bg-gospel-navy-800 text-white font-bold px-6 py-3 rounded-xl text-sm shadow-md transition-all active:scale-95"
          >
            <svg class="w-4 h-4 text-gospel-gold-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14" />
            </svg>
            <span>Abrir en Google Maps</span>
          </a>

          <button 
            id="copy-address-btn"
            type="button"
            data-address={address}
            class="inline-flex items-center gap-2 bg-slate-100 hover:bg-slate-200 text-slate-800 font-semibold px-5 py-3 rounded-xl text-sm border border-slate-300 transition-all active:scale-95"
          >
            <svg class="w-4 h-4 text-slate-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" />
            </svg>
            <span id="copy-btn-text">Copiar Dirección</span>
          </button>
        </div>
      </div>

      <!-- Right Visual Map Card Representation -->
      <div class="md:col-span-5 flex justify-center">
        <div class="w-full bg-gospel-navy-950 rounded-2xl p-6 text-white text-center space-y-4 border border-gospel-gold-400/30 shadow-inner">
          <div class="w-16 h-16 rounded-full bg-gold-gradient text-gospel-navy-950 mx-auto flex items-center justify-center font-bold text-2xl shadow-lg">
            ⛪
          </div>
          <h4 class="font-extrabold text-xl text-white">Gospel</h4>
          <p class="text-xs text-gospel-gold-300 uppercase tracking-widest font-semibold">Iglesia con Propósito</p>
          <div class="bg-gospel-navy-900 rounded-xl p-3 border border-slate-800 text-xs text-slate-300">
            <span class="block text-slate-400 font-medium">Referencia:</span>
            Cto. Hacienda del Real 1716
          </div>
          <a 
            href={googleMapsUrl}
            target="_blank" 
            rel="noopener noreferrer"
            class="block w-full py-2.5 rounded-lg bg-gospel-gold-500 text-gospel-navy-950 font-bold text-xs uppercase tracking-wider hover:brightness-110 transition-all"
          >
            Ver Ruta GPS
          </a>
        </div>
      </div>

    </div>

  </div>
</section>

<script>
  const copyBtn = document.getElementById('copy-address-btn');
  const copyBtnText = document.getElementById('copy-btn-text');

  if (copyBtn && copyBtnText) {
    copyBtn.addEventListener('click', async () => {
      const address = copyBtn.getAttribute('data-address') || '';
      try {
        await navigator.clipboard.writeText(address);
        copyBtnText.textContent = '¡Copiada!';
        copyBtn.classList.add('bg-emerald-100', 'text-emerald-800', 'border-emerald-300');
        setTimeout(() => {
          copyBtnText.textContent = 'Copiar Dirección';
          copyBtn.classList.remove('bg-emerald-100', 'text-emerald-800', 'border-emerald-300');
        }, 2500);
      } catch (err) {
        console.error('Error al copiar:', err);
      }
    });
  }
</script>
