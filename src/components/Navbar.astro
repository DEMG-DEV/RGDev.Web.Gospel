---
// Header / Navigation Bar Component
---

<header class="sticky top-0 z-50 bg-gospel-navy-950/90 backdrop-blur-md border-b border-gospel-gold-500/20 text-white transition-all duration-300">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      
      <!-- Brand / Logo -->
      <a href="#inicio" class="flex items-center gap-3 group focus:outline-none focus:ring-2 focus:ring-gospel-gold-400 rounded-lg p-1">
        <div class="w-12 h-12 rounded-full overflow-hidden bg-white p-0.5 border border-gospel-gold-400/50 shadow-md group-hover:scale-105 transition-transform">
          <img src="/assets/logo.jpg" alt="Logotipo de Gospel - Iglesia con Propósito" width="48" height="48" class="w-full h-full object-contain" />
        </div>
        <div class="flex flex-col">
          <span class="font-extrabold text-xl tracking-tight text-white group-hover:text-gospel-gold-400 transition-colors">
            GOSPEL
          </span>
          <span class="text-xs uppercase tracking-widest text-gospel-gold-400 font-medium">
            Iglesia con Propósito
          </span>
        </div>
      </a>

      <!-- Desktop Nav Links -->
      <nav class="hidden md:flex items-center space-x-8">
        <a href="#inicio" class="text-sm font-medium text-slate-200 hover:text-gospel-gold-400 transition-colors">
          Inicio
        </a>
        <a href="#pilares" class="text-sm font-medium text-slate-200 hover:text-gospel-gold-400 transition-colors">
          Pilares
        </a>
        <a href="#nosotros" class="text-sm font-medium text-slate-200 hover:text-gospel-gold-400 transition-colors">
          Nosotros
        </a>
        <a href="#horarios" class="text-sm font-medium text-slate-200 hover:text-gospel-gold-400 transition-colors">
          Horarios
        </a>
        <a href="#ubicacion" class="text-sm font-medium text-slate-200 hover:text-gospel-gold-400 transition-colors">
          Ubicación
        </a>
      </nav>

      <!-- Action Button -->
      <div class="hidden sm:flex items-center gap-3">
        <a 
          href="https://wa.me/?text=Hola%2C%20quisiera%20m%C3%A1s%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20la%20Iglesia%20Gospel." 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 bg-gold-gradient text-gospel-navy-950 font-bold px-4 py-2 rounded-full text-sm hover:brightness-110 shadow-lg shadow-gospel-gold-500/20 active:scale-95 transition-all"
        >
          <svg class="w-4 h-4 fill-current" viewBox="0 0 24 24">
            <path d="M12.031 6.172c-3.181 0-5.767 2.586-5.768 5.766-.001 1.298.38 2.27 1.019 3.287l-.582 2.128 2.182-.573c.978.58 1.911.928 3.145.929 3.178 0 5.767-2.587 5.768-5.766.001-3.187-2.575-5.77-5.764-5.771zm3.392 8.244c-.144.405-.837.774-1.17.824-.299.045-.677.063-1.092-.069-.252-.08-.575-.187-.988-.365-1.739-.751-2.874-2.502-2.961-2.617-.087-.116-.708-.94-.708-1.793s.448-1.273.607-1.446c.159-.173.346-.217.462-.217l.332.006c.106.005.249-.04.39.299.144.347.491 1.2.534 1.287.043.087.072.188.014.304-.058.116-.087.188-.173.289l-.26.304c-.087.086-.177.18-.076.354.101.174.449.741.964 1.201.662.591 1.221.774 1.394.86s.275.058.376-.058c.101-.116.433-.506.549-.68.116-.173.231-.145.39-.087s1.011.477 1.184.564.289.13.332.202c.043.073.043.419-.101.824z"/>
          </svg>
          <span>Escríbenos</span>
        </a>
      </div>

      <!-- Mobile Menu Toggle Button -->
      <div class="flex md:hidden">
        <button 
          id="mobile-menu-button"
          type="button" 
          aria-label="Abrir menú principal"
          class="p-2 text-slate-300 hover:text-white hover:bg-gospel-navy-800 rounded-lg focus:outline-none focus:ring-2 focus:ring-gospel-gold-400"
        >
          <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16m-7 6h7" />
          </svg>
        </button>
      </div>

    </div>
  </div>

  <!-- Mobile Dropdown Menu -->
  <div id="mobile-menu" class="hidden md:hidden bg-gospel-navy-900 border-b border-gospel-gold-500/20 px-4 pt-2 pb-6 space-y-3">
    <a href="#inicio" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:text-gospel-gold-400 hover:bg-gospel-navy-800">
      Inicio
    </a>
    <a href="#pilares" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:text-gospel-gold-400 hover:bg-gospel-navy-800">
      Pilares
    </a>
    <a href="#nosotros" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:text-gospel-gold-400 hover:bg-gospel-navy-800">
      Nosotros
    </a>
    <a href="#horarios" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:text-gospel-gold-400 hover:bg-gospel-navy-800">
      Horarios
    </a>
    <a href="#ubicacion" class="block px-3 py-2 rounded-md text-base font-medium text-slate-200 hover:text-gospel-gold-400 hover:bg-gospel-navy-800">
      Ubicación
    </a>
    <div class="pt-2">
      <a 
        href="https://wa.me/?text=Hola%2C%20quisiera%20m%C3%A1s%20informaci%C3%B3n%20sobre%20los%20servicios%20de%20la%20Iglesia%20Gospel." 
        target="_blank" 
        rel="noopener noreferrer"
        class="w-full flex items-center justify-center gap-2 bg-gold-gradient text-gospel-navy-950 font-bold px-4 py-3 rounded-xl text-center shadow-md"
      >
        <span>Contáctanos por WhatsApp</span>
      </a>
    </div>
  </div>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  
  if (button && menu) {
    button.addEventListener('click', () => {
      menu.classList.toggle('hidden');
    });

    const links = menu.querySelectorAll('a');
    links.forEach(link => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
      });
    });
  }
</script>
