---
// Pillars Section Component (Enseñanza, Adoración, Comunidad)
const pillars = [
  {
    title: "Enseñanza",
    subtitle: "Basada en la Palabra de Dios",
    description: "Creemos firmemente en el poder transformador de las Sagradas Escrituras. Compartimos mensajes claros, bíblicos y prácticos que edifican tu vida personal, familiar y profesional.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M12 6.253v13m0-13C10.832 5.477 9.246 5 7.5 5S4.168 5.477 3 6.253v13C4.168 18.477 5.754 18 7.5 18s3.332.477 4.5 1.253m0-13C13.168 5.477 14.754 5 16.5 5c1.747 0 3.332.477 4.5 1.253v13C19.832 18.477 18.247 18 16.5 18c-1.746 0-3.332.477-4.5 1.253" />`,
    badge: "Fundamento Bíblico"
  },
  {
    title: "Adoración",
    subtitle: "Momentos de alabanza y oración",
    description: "Un espacio genuino de gratitud, fe y comunión donde exaltamos el nombre de Jesús y experimentamos la paz sobrenatural de su presencia en unidad congregacional.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z" />`,
    badge: "Presencia de Dios"
  },
  {
    title: "Comunidad",
    subtitle: "Un lugar donde eres bienvenido",
    description: "Una familia de fe que te recibe con brazos abiertos. Aquí encontrarás amistades sinceras, apoyo en momentos difíciles y un ambiente cálido para tus hijos y seres queridos.",
    icon: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />`,
    badge: "Familia y Amigos"
  }
];
---

<section id="pilares" class="py-20 lg:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-3.5 py-1 rounded-full bg-gospel-gold-100 text-gospel-gold-700 text-xs sm:text-sm font-bold uppercase tracking-widest">
        Nuestros Fundamentos
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gospel-navy-950 tracking-tight">
        Lo que Vivimos y Compartimos
      </h2>
      <p class="text-slate-600 text-lg sm:text-xl">
        Descubre los tres pilares esenciales que guían nuestras reuniones, nuestra fe y el cuidado de cada persona.
      </p>
    </div>

    <!-- Pillars Grid -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-3 gap-8">
      {pillars.map((pillar, idx) => (
        <div class="group relative bg-slate-50 hover:bg-white rounded-3xl p-8 border border-slate-200/80 hover:border-gospel-gold-400/60 shadow-sm hover:shadow-xl hover:-translate-y-1.5 transition-all duration-300 flex flex-col justify-between">
          
          <div>
            <!-- Icon with Gold Gradient Glow -->
            <div class="w-16 h-16 rounded-2xl bg-gospel-navy-950 text-gospel-gold-400 flex items-center justify-center mb-6 shadow-md group-hover:scale-110 group-hover:bg-gold-gradient group-hover:text-gospel-navy-950 transition-all duration-300">
              <svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={pillar.icon} />
            </div>

            <!-- Badge -->
            <span class="text-xs font-semibold uppercase tracking-wider text-gospel-gold-600">
              {pillar.badge}
            </span>

            <!-- Title -->
            <h3 class="text-2xl font-bold text-gospel-navy-950 mt-1 mb-2 group-hover:text-gospel-gold-600 transition-colors">
              {pillar.title}
            </h3>

            <!-- Subtitle -->
            <p class="text-sm font-semibold text-slate-700 mb-4 pb-3 border-b border-slate-200">
              {pillar.subtitle}
            </p>

            <!-- Description -->
            <p class="text-slate-600 leading-relaxed text-sm sm:text-base">
              {pillar.description}
            </p>
          </div>

          <!-- Bottom Visual Indicator -->
          <div class="mt-6 pt-4 flex items-center text-xs font-bold text-gospel-navy-800 group-hover:text-gospel-gold-600">
            <span>Pilar 0{idx + 1}</span>
            <span class="ml-2 h-0.5 w-6 bg-gospel-gold-400"></span>
          </div>

        </div>
      ))}
    </div>

  </div>
</section>
