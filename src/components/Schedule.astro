---
// Service Schedules Component
const services = [
  {
    day: "Miércoles",
    time: "7:00 PM",
    title: "Servicio de Oración y Discipulado",
    description: "Una pausa en la semana para recargar fuerzas, estudiar la Palabra en profundidad y buscar la presencia de Dios en oración comunitaria.",
    tag: "Mitad de Semana",
    highlight: false,
  },
  {
    day: "Domingo",
    time: "10:30 AM",
    title: "Servicio Familiar de Celebración",
    description: "Nuestra reunión principal de adoración, alabanza congregacional y mensaje bíblico edificante para toda la familia y amigos.",
    tag: "Reunión Principal",
    highlight: true,
  }
];
---

<section id="horarios" class="py-20 lg:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-3.5 py-1 rounded-full bg-gospel-gold-100 text-gospel-gold-700 text-xs sm:text-sm font-bold uppercase tracking-widest">
        Nuestras Reuniones
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gospel-navy-950 tracking-tight">
        Horarios de Servicios
      </h2>
      <p class="text-slate-600 text-lg sm:text-xl">
        Te esperamos con los brazos abiertos. Elige el horario que mejor se adapte a ti y acompáñanos.
      </p>
    </div>

    <!-- Service Cards -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 gap-8 max-w-5xl mx-auto">
      {services.map((service) => (
        <div class={`relative rounded-3xl p-8 sm:p-10 transition-all duration-300 flex flex-col justify-between ${
          service.highlight 
            ? 'bg-gospel-navy-950 text-white border-2 border-gospel-gold-400 shadow-2xl shadow-gospel-navy-950/20' 
            : 'bg-slate-50 text-slate-800 border border-slate-200 shadow-lg hover:border-gospel-gold-400'
        }`}>
          
          <!-- Top Badge -->
          <div>
            <div class="flex items-center justify-between gap-4 mb-6">
              <span class={`text-xs font-extrabold uppercase tracking-widest px-3 py-1 rounded-full ${
                service.highlight 
                  ? 'bg-gospel-gold-500 text-gospel-navy-950' 
                  : 'bg-slate-200 text-slate-700'
              }`}>
                {service.tag}
              </span>
              <div class="flex items-center gap-1 text-gospel-gold-400">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>

            <!-- Day & Time -->
            <div class="mb-4">
              <span class={`text-sm font-semibold uppercase tracking-wider ${
                service.highlight ? 'text-gospel-gold-300' : 'text-gospel-gold-600'
              }`}>
                {service.day}
              </span>
              <h3 class={`text-4xl sm:text-5xl font-black mt-1 ${
                service.highlight ? 'text-white' : 'text-gospel-navy-950'
              }`}>
                {service.time}
              </h3>
            </div>

            <!-- Title & Description -->
            <h4 class={`text-xl font-bold mb-3 ${
              service.highlight ? 'text-gospel-gold-200' : 'text-slate-900'
            }`}>
              {service.title}
            </h4>

            <p class={`leading-relaxed text-sm sm:text-base ${
              service.highlight ? 'text-slate-300' : 'text-slate-600'
            }`}>
              {service.description}
            </p>
          </div>

          <!-- Bottom Action Callout -->
          <div class={`mt-8 pt-6 border-t flex items-center justify-between ${
            service.highlight ? 'border-slate-800 text-slate-400' : 'border-slate-200 text-slate-500'
          }`}>
            <span class="text-xs font-medium">Entrada libre y gratuita</span>
            <a 
              href="#ubicacion" 
              class={`text-xs font-bold flex items-center gap-1 hover:underline ${
                service.highlight ? 'text-gospel-gold-300' : 'text-gospel-gold-600'
              }`}
            >
              <span>Ver ubicación</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Extra Community Note -->
    <div class="mt-12 text-center">
      <p class="text-slate-500 text-sm max-w-xl mx-auto">
        Recomendamos llegar 10 minutos antes para ubicarte cómodamente. ¡Tendremos un lugar listo para ti y tu familia!
      </p>
    </div>

  </div>
</section>
