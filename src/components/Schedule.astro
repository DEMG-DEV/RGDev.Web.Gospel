---
// Service Schedules Component
const services = [
  {
    day: "Domingo",
    time: "7:00 PM",
    title: "Servicio General",
    description: "Nuestra reunión principal de adoración congregacional, celebración y mensaje bíblico para toda la familia y amigos.",
    tag: "Servicio Principal",
    highlight: true,
  },
  {
    day: "Lunes",
    time: "8:00 PM",
    title: "Reunión de Oración",
    description: "Tiempo consagrado a la intercesión comunitaria, clamor y búsqueda de la presencia y dirección de Dios.",
    tag: "Oración",
    highlight: false,
  },
  {
    day: "Miércoles",
    time: "8:00 PM",
    title: "Servicio de Adoración",
    description: "Una pausa en la semana para recargar fuerzas, adorar a Dios en unidad y recibir un mensaje edificante.",
    tag: "Adoración",
    highlight: false,
  },
  {
    day: "Sábado",
    time: "7:00 PM",
    title: "Seminario y Estudio Bíblico",
    description: "Formación doctrinal y crecimiento espiritual a través del estudio profundo y práctico de las Sagradas Escrituras.",
    tag: "Seminario / Estudio",
    highlight: false,
  }
];
---

<section id="horarios" class="py-20 lg:py-28 bg-white relative">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="text-center max-w-3xl mx-auto space-y-4">
      <span class="inline-block px-3.5 py-1 rounded-full bg-gospel-gold-100 text-gospel-gold-700 text-xs sm:text-sm font-bold uppercase tracking-widest">
        Nuestras Reuniones
      </span>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gospel-navy-950 tracking-tight">
        Horarios de Servicios
      </h2>
      <p class="text-slate-600 text-lg sm:text-xl">
        Te esperamos con los brazos abiertos. Elige el horario que mejor se adapte a ti y acompáñanos.
      </p>
    </div>

    <!-- Service Cards -->
    <div class="mt-16 grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 max-w-7xl mx-auto">
      {services.map((service) => (
        <div class={`relative rounded-3xl p-6 sm:p-7 transition-all duration-300 flex flex-col justify-between ${
          service.highlight 
            ? 'bg-gospel-navy-950 text-white border-2 border-gospel-gold-400 shadow-2xl shadow-gospel-navy-950/20' 
            : 'bg-slate-50 text-slate-800 border border-slate-200 shadow-lg hover:border-gospel-gold-400'
        }`}>
          
          <!-- Top Badge -->
          <div>
            <div class="flex items-center justify-between gap-2 mb-6">
              <span class={`text-[11px] font-extrabold uppercase tracking-wider px-2.5 py-1 rounded-full ${
                service.highlight 
                  ? 'bg-gospel-gold-500 text-gospel-navy-950' 
                  : 'bg-slate-200 text-slate-700'
              }`}>
                {service.tag}
              </span>
              <div class="flex items-center gap-1 text-gospel-gold-400">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm1-12a1 1 0 10-2 0v4a1 1 0 00.293.707l2.828 2.829a1 1 0 101.415-1.415L11 9.586V6z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>

            <!-- Day & Time -->
            <div class="mb-4">
              <span class={`text-xs font-semibold uppercase tracking-wider ${
                service.highlight ? 'text-gospel-gold-300' : 'text-gospel-gold-600'
              }`}>
                {service.day}
              </span>
              <h3 class={`text-3xl sm:text-4xl font-black mt-1 ${
                service.highlight ? 'text-white' : 'text-gospel-navy-950'
              }`}>
                {service.time}
              </h3>
            </div>

            <!-- Title & Description -->
            <h4 class={`text-lg font-bold mb-2 ${
              service.highlight ? 'text-gospel-gold-200' : 'text-slate-900'
            }`}>
              {service.title}
            </h4>

            <p class={`leading-relaxed text-sm ${
              service.highlight ? 'text-slate-300' : 'text-slate-600'
            }`}>
              {service.description}
            </p>
          </div>

          <!-- Bottom Action Callout -->
          <div class={`mt-8 pt-6 border-t flex items-center justify-between ${
            service.highlight ? 'border-slate-800 text-slate-400' : 'border-slate-200 text-slate-500'
          }`}>
            <span class="text-xs font-medium">Entrada libre y gratuita</span>
            <a 
              href="#ubicacion" 
              class={`text-xs font-bold flex items-center gap-1 hover:underline ${
                service.highlight ? 'text-gospel-gold-300' : 'text-gospel-gold-600'
              }`}
            >
              <span>Ver ubicación</span>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
            </a>
          </div>

        </div>
      ))}
    </div>

    <!-- Extra Community Note -->
    <div class="mt-12 text-center">
      <p class="text-slate-500 text-sm max-w-xl mx-auto">
        Recomendamos llegar 10 minutos antes para ubicarte cómodamente. ¡Tendremos un lugar listo para ti y tu familia!
      </p>
    </div>

  </div>
</section>
